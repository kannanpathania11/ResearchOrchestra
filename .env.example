# ── LLM (Groq) ────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Web Search (Tavily) ───────────────────────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres?sslmode=disable

# ── Firebase (backend auth) ───────────────────────────────────────────────────
# Only the project ID is needed — the backend verifies tokens using Firebase's
# public keys, so no service account or credentials file is required.
FIREBASE_PROJECT_ID=your_firebase_project_id

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Set to your frontend URL in production.
ALLOWED_ORIGINS=http://localhost:3000

# ── LangSmith observability (optional) ───────────────────────────────────────
# Sign up at https://smith.langchain.com to enable full LangGraph tracing.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=ResearchOrchestra

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
